# GPT for Support Chat
# Option 1 (quick): direct call from browser to OpenAI.
# Note: API key is embedded into frontend bundle during build.
VITE_OPENAI_API_KEY=

# Option 2 (recommended for production): server proxy endpoint.
# If set, this is used instead of VITE_OPENAI_API_KEY.
# Example: https://your-domain.ru/api/support-chat
VITE_OPENAI_API_PROXY_URL=

# OpenAI model for support widget
VITE_SUPPORT_MODEL=gpt-4o-mini
